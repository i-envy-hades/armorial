{
  "hosting": {
    "site": "armorial",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "**/.*",
      ".git/**",
      "**/.git/**",
      ".claude/**",
      "**/.claude/**",
      ".github/**",
      ".firebase/**",
      "**/node_modules/**",
      "tools/**",
      "README.md",
      "LICENSE"
    ],
    "redirects": [
      {
        "source": "/jeu.html",
        "destination": "/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "assets/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "assets/{meubles,ornements,epopee}/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|json|xml)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "tools/firebase/firestore.rules"
  }
}
